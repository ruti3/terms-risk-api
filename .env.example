OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
CACHE_DB_PATH=data/cache.sqlite
LOG_DIR=data/logs
REQUEST_TIMEOUT_SECONDS=15
MAX_TEXT_CHARS=12000

# x402 / x402scan discovery (https://x402scan.com/discovery/spec)
X402_ENABLED=false
X402_SKIP_PAYMENT=true
X402_PAY_TO=0xYourWalletAddress
# eip155:84532 = Base Sepolia (x402.org facilitator). Use eip155:8453 + mainnet facilitator for production.
X402_NETWORK=eip155:84532
# Testnet (no auth): https://x402.org/facilitator
# Production / CDP (requires CDP_API_KEY_ID + CDP_API_KEY_SECRET below):
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_URL=https://x402.org/facilitator
# x402 price is dynamic: $0.01 cached url+use_case, $0.03 fresh (see app/pricing.py)
# Optional: set when behind a reverse proxy (e.g. https://api.example.com)
# PUBLIC_BASE_URL=https://api.example.com

CDP_API_KEY_ID=your-api-key-id
CDP_API_KEY_SECRET=your-api-key-secret
CDP_WALLET_SECRET=your-wallet-secret
# Or use cdp_api_key.json + cdp_wallet_secret.txt (gitignored) — see scripts/create-receiver-wallet.mjs